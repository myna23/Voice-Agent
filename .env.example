# Intron Sahara voice API — https://voice.intron.io
INTRON_API_KEY=REPLACE_WITH_YOUR_SAHARA_KEY

# Groq — free tier, used for the Whisper-large-v3 STT baseline and the
# intent-parsing agent (llama-3.3-70b-versatile). Get a free key at
# https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY

# Local faster-whisper model size (tiny/base/small/medium) — small is a good speed/accuracy
# tradeoff on CPU for short clips. No API key needed for this engine.
LOCAL_WHISPER_MODEL=small

# Set to "true" to attempt a spoken confirmation via Sahara TTS after each action.
# Sahara TTS is async (enqueue + poll); the app always falls back to text-only if it
# doesn't finish within TTS_TIMEOUT_SECONDS, so this never blocks the core demo.
ENABLE_TTS=false
TTS_TIMEOUT_SECONDS=8
